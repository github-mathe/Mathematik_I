nax.set_xlim(-2*np.pi, 2*np.pi)\nax.set_ylim(-5, 5)\n\nax.set_xticks([\n    -2*np.pi,\n    -3*np.pi/2,\n    -np.pi,\n    -np.pi/2,\n    0,\n    np.pi/2,\n    np.pi,\n    3*np.pi/2,\n    2*np.pi\n])\n\nax.set_xticklabels([\n    r\"$-2\\pi$\",\n    r\"$-\\frac{3\\pi}{2}$\",\n    r\"$-\\pi$\",\n    r\"$-\\frac{\\pi}{2}$\",\n    r\"$0$\",\n    r\"$\\frac{\\pi}{2}$\",\n    r\"$\\pi$\",\n    r\"$\\frac{3\\pi}{2}$\",\n    r\"$2\\pi$\"\n])\n\nax.set_yticks([-4, -2, 0, 2, 4])\n\nax.set_xlabel(\"$x$\")\nax.set_ylabel(r\"$y=\\tan x$\")\n\nax.grid()\n\nplt.show()","visibility":"hide","key":"lcM2Ot3AG0"},{"type":"outputs","id":"2SqmG_W8RAZ-ll8tSF4E6","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"32f147157824252652cfe40326ae8643","path":"/32f147157824252652cfe40326ae8643.png"},"text/plain":{"content":"<Figure size 1000x500 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"vU5W9NZpSC"}],"visibility":"show","key":"EOBR1Xbowf"}],"visibility":"show","key":"gYf4gv3cu1"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Die Umkehrfunktion der Tangensfunktion","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VwrDfZsMLB"}],"identifier":"die-umkehrfunktion-der-tangensfunktion","label":"Die Umkehrfunktion der Tangensfunktion","html_id":"die-umkehrfunktion-der-tangensfunktion","implicit":true,"key":"WmkY8Swep7"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Die ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XTp1uHm5xY"},{"type":"st