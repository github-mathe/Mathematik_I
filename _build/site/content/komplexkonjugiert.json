fontsize=11)\n\nax.set_xlim(-1.5, 4.3)\nax.set_ylim(-2.2, 2.2)\nax.set_aspect(\"equal\")\nax.axis(\"off\")\n\nplt.show()","visibility":"hide","key":"GWXEvNATv7"},{"type":"outputs","id":"77LMN6eRbEZnlb_o5rxP-","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"149d3998fd132fb36a46ae21ca5b3c62","path":"/149d3998fd132fb36a46ae21ca5b3c62.png"},"text/plain":{"content":"<Figure size 700x500 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"dO6l1OryJa"}],"visibility":"show","key":"PcZxmwu5On"}],"visibility":"show","key":"vlJtF9pAYw"}],"key":"UG46IBtCsA"},"references":{"cite":{"order":[],"data":{}}}}