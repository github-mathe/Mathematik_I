fontsize=11)\n\nax.set_xlim(-1.5, 4.3)\nax.set_ylim(-2.2, 2.2)\nax.set_aspect(\"equal\")\nax.axis(\"off\")\n\nplt.show()","visibility":"hide","key":"dqSCMvZcfm"},{"type":"outputs","id":"2_zBAD4pPqnHHBWBWTbTy","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"149d3998fd132fb36a46ae21ca5b3c62","path":"/149d3998fd132fb36a46ae21ca5b3c62.png"},"text/plain":{"content":"<Figure size 700x500 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"Wza1Jm18ea"}],"visibility":"show","key":"rAo9691KLY"}],"visibility":"show","key":"mqvQnHrAY3"}],"key":"XdYfJdHJix"},"references":{"cite":{"order":[],"data":{}}}}