fontsize=11)\n\nax.set_xlim(-1.5, 4.3)\nax.set_ylim(-2.2, 2.2)\nax.set_aspect(\"equal\")\nax.axis(\"off\")\n\nplt.show()","visibility":"hide","key":"S5DprzzDRf"},{"type":"outputs","id":"h7B5S1ZuTfS5kjh7v7_em","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"149d3998fd132fb36a46ae21ca5b3c62","path":"/149d3998fd132fb36a46ae21ca5b3c62.png"},"text/plain":{"content":"<Figure size 700x500 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"MkjCMj6nzv"}],"visibility":"show","key":"iOsenKr7ID"}],"visibility":"show","key":"owaX5JvJJZ"}],"key":"pz5Yna8AKB"},"references":{"cite":{"order":[],"data":{}}}}