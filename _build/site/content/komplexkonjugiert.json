fontsize=11)\n\nax.set_xlim(-1.5, 4.3)\nax.set_ylim(-2.2, 2.2)\nax.set_aspect(\"equal\")\nax.axis(\"off\")\n\nplt.show()","visibility":"hide","key":"gGm8YhNnZW"},{"type":"outputs","id":"fa4TD_Rtvoqc1DxfmA4_E","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"149d3998fd132fb36a46ae21ca5b3c62","path":"/149d3998fd132fb36a46ae21ca5b3c62.png"},"text/plain":{"content":"<Figure size 700x500 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"zzsUmQX5qt"}],"visibility":"show","key":"NApgHWl28E"}],"visibility":"show","key":"UjUnMpHpbX"}],"key":"V6tl1hTxto"},"references":{"cite":{"order":[],"data":{}}}}